<footer class="footer">
  <div class="container footer-inner">
    <span>&copy; <span id="yil"></span> MAKÜ Bucak Teknoloji Fakültesi · Tüm hakları saklıdır.</span>
    <a href="https://teknoloji.mehmetakif.edu.tr/" target="_blank" rel="noopener">teknoloji.mehmetakif.edu.tr</a>
  </div>
</footer>

<script>
  // Yıl
  document.getElementById("yil").textContent = new Date().getFullYear();

  // Tema değiştirme
  (function () {
    var kok = document.documentElement;
    var btn = document.getElementById("temaButonu");
    var ikon = document.getElementById("temaIkon");
    function ikonGuncelle() {
      var koyu =
        kok.getAttribute("data-theme") === "dark" ||
        (!kok.getAttribute("data-theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      if (ikon) ikon.textContent = koyu ? "☀" : "☾";
    }
    ikonGuncelle();
    if (btn) {
      btn.addEventListener("click", function () {
        var suanki =
          kok.getAttribute("data-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        var yeni = suanki === "dark" ? "light" : "dark";
        kok.setAttribute("data-theme", yeni);
        localStorage.setItem("tema", yeni);
        ikonGuncelle();
      });
    }
  })();

  // Yönetici saat/tarih göstergesi
  (function () {
    var el = document.getElementById("saatTarih");
    if (!el) return;
    var bicim = new Intl.DateTimeFormat("tr-TR", {
      day: "2-digit", month: "2-digit", year: "numeric",
      hour: "2-digit", minute: "2-digit", second: "2-digit",
    });
    function guncelle() { el.textContent = bicim.format(new Date()); }
    guncelle();
    setInterval(guncelle, 1000);
  })();
</script>
</body>
</html>
