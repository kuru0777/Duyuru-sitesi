<%- include('includes/head.ejs') %>
<body>
  <div class="auth">
    <aside class="auth-aside">
      <span class="brand-mark" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11l18-5v12L3 14v-3z"></path>
          <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
        </svg>
      </span>
      <h2>Duyuru Merkezi'ne hoş geldiniz</h2>
      <p>Yönetici hesabınızla giriş yaparak duyuru ekleyebilir, düzenleyebilir ve yönetebilirsiniz.</p>
    </aside>

    <div class="auth-main">
      <div class="auth-form">
        <h1>Giriş Yap</h1>
        <p class="sub">Hesabın yok mu? <a href="/kayit">Kayıt ol</a></p>

        <% if (hata) { %><div class="alert"><%= hata %></div><% } %>

        <form method="post" action="/giris">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="eposta">E-posta</label>
            <input class="input" type="email" id="eposta" name="eposta" required placeholder="ornek@mehmetakif.edu.tr">
          </div>
          <div class="field">
            <label for="sifre">Şifre</label>
            <input class="input" type="password" id="sifre" name="sifre" required placeholder="••••••••">
          </div>
          <button class="btn btn-primary btn-lg" type="submit">Giriş Yap</button>
        </form>

        <p style="margin-top:24px;"><a class="back-link" href="/">← Anasayfaya dön</a></p>
      </div>
    </div>
  </div>

  <%- include('includes/foot.ejs') %>
