<%- include('includes/head.ejs') %>
<body>
  <div class="auth">
    <aside class="auth-aside">
      <span class="brand-mark" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11l18-5v12L3 14v-3z"></path>
          <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
        </svg>
      </span>
      <h2>Yönetici hesabı oluşturun</h2>
      <p>Fakülte bilgilerinizle kayıt olun; onay sonrası duyuru paylaşabilirsiniz.</p>
    </aside>

    <div class="auth-main">
      <div class="auth-form">
        <h1>Kayıt Ol</h1>
        <p class="sub">Zaten hesabın var mı? <a href="/giris">Giriş yap</a></p>

        <% if (hata) { %><div class="alert"><%= hata %></div><% } %>

        <form method="post" action="/kayit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field-row">
            <div class="field">
              <label for="ad">Ad</label>
              <input class="input" type="text" id="ad" name="ad" required>
            </div>
            <div class="field">
              <label for="soyad">Soyad</label>
              <input class="input" type="text" id="soyad" name="soyad" required>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="okulNumarasi">Okul Numarası</label>
              <input class="input" type="text" id="okulNumarasi" name="okulNumarasi" required>
            </div>
            <div class="field">
              <label for="bolum">Bölüm</label>
              <input class="input" type="text" id="bolum" name="bolum" required>
            </div>
          </div>
          <div class="field">
            <label for="dogumTarihi">Doğum Tarihi</label>
            <input class="input" type="date" id="dogumTarihi" name="dogumTarihi" required>
          </div>
          <div class="field">
            <label for="eposta">E-posta</label>
            <input class="input" type="email" id="eposta" name="eposta" required placeholder="ornek@mehmetakif.edu.tr">
          </div>
          <div class="field">
            <label for="sifre">Şifre</label>
            <input class="input" type="password" id="sifre" name="sifre" required minlength="6" placeholder="En az 6 karakter">
          </div>
          <button class="btn btn-primary btn-lg" type="submit">Kayıt Ol</button>
        </form>

        <p style="margin-top:24px;"><a class="back-link" href="/">← Anasayfaya dön</a></p>
      </div>
    </div>
  </div>

  <%- include('includes/foot.ejs') %>
