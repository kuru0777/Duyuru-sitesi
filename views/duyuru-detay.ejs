<%- include('includes/head.ejs') %>
<body>
  <%- include('includes/nav.ejs') %>

  <main class="page">
    <div class="container">
      <a class="back-link" href="/">← Tüm duyurular</a>

      <div class="detail">
        <div class="detail-media">
          <% if (duyuru.resim_yol) { %>
            <img src="<%= duyuru.resim_yol %>" alt="<%= duyuru.duyuru_adi %>">
          <% } %>
        </div>

        <div>
          <span class="eyebrow">Duyuru</span>
          <h1><%= duyuru.duyuru_adi %></h1>
          <p class="lead"><%= duyuru.aciklama %></p>
          <div class="detail-content"><%= duyuru.icerik %></div>

          <ul class="detail-facts">
            <li><span class="k">Yayın tarihi</span><span class="v"><%= tarih.bicimlendir(duyuru.gtarih) %></span></li>
            <li><span class="k">Bitiş tarihi</span><span class="v"><%= tarih.bicimlendir(duyuru.btarih) %></span></li>
            <% if (duyuru.yazan) { %>
              <li><span class="k">Duyuruyu yapan</span><span class="v"><%= duyuru.yazan.ad %> <%= duyuru.yazan.soyad %></span></li>
            <% } %>
            <li><span class="k">Görüntülenme</span><span class="v"><%= duyuru.tiklanma %></span></li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <%- include('includes/foot.ejs') %>
