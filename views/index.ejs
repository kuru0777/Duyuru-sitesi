<%- include('includes/head.ejs') %>
<body>
  <%- include('includes/nav.ejs') %>

  <main class="page">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Duyuru Merkezi</span>
          <h1>Güncel Duyurular</h1>
          <p><%= duyurular.length %> aktif duyuru listeleniyor.</p>
        </div>
        <% if (yonetici) { %>
          <a class="btn btn-primary" href="/duyuru-ekle">+ Yeni Duyuru</a>
        <% } %>
      </div>

      <% if (duyurular.length > 0) { %>
        <div class="grid">
          <% duyurular.forEach(function (duyuru) { %>
            <article class="card">
              <a class="card-media" href="/duyuru-detay/<%= duyuru._id %>" aria-label="<%= duyuru.duyuru_adi %>">
                <% if (duyuru.resim_yol) { %>
                  <img src="<%= duyuru.resim_yol %>" alt="<%= duyuru.duyuru_adi %>" loading="lazy">
                <% } else { %>
                  <span class="placeholder"><%= duyuru.duyuru_adi.charAt(0).toUpperCase() %></span>
                <% } %>
              </a>
              <div class="card-body">
                <h2 class="card-title"><a href="/duyuru-detay/<%= duyuru._id %>"><%= duyuru.duyuru_adi %></a></h2>
                <p class="card-desc"><%= duyuru.aciklama %></p>
                <div class="card-meta">
                  <span class="badge"><%= tarih.bicimlendir(duyuru.gtarih) %></span>
                  <span class="badge badge-views">👁 <%= duyuru.tiklanma %></span>
                </div>
              </div>
              <div class="card-actions">
                <a class="btn btn-outline btn-sm" href="/duyuru-detay/<%= duyuru._id %>">Detay</a>
                <% if (yonetici) { %>
                  <a class="btn btn-outline btn-sm" href="/duyuru-duzenle/<%= duyuru._id %>">Düzenle</a>
                  <form action="/duyuru-sil" method="post"
                    onsubmit="return confirm('Bu duyuru silinsin mi?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="duyuruId" value="<%= duyuru._id %>">
                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                  </form>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty">
          <div class="icon">📭</div>
          <p>Şu anda gösterilecek aktif duyuru bulunmuyor.</p>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('includes/foot.ejs') %>
