# --- MongoDB (opsiyonel) ---
# Boş bırakırsanız uygulama otomatik olarak yerel bir veritabanı kullanır
# (mongodb-memory-server, ./.local-db klasöründe). Hiçbir kurulum gerekmez.
# Kendi MongoDB / Atlas kümenizi bağlamak isterseniz burayı doldurun:
#   MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@HOST/iwebDB?retryWrites=true&w=majority
MONGODB_URI=

# --- Oturum (session) imzalama anahtarı ---
# Uzun, rastgele bir değer olmalı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=degistirilmesi-gereken-uzun-rastgele-bir-anahtar

# --- Sunucu portu ---
PORT=3000
